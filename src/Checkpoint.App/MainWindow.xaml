<Window x:Class="Checkpoint.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Checkpoint" Width="510" Height="740" MinWidth="365" MinHeight="440" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Window.Resources>
    <DataTemplate x:Key="GameTemplate">
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="12" Tag="{Binding Model}" AllowDrop="True" DragOver="CardDragOver" DragLeave="CardDragLeave" Drop="CardDrop">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <Border Width="{Binding CoverWidth}" Height="{Binding CoverHeight}" Margin="0,0,13,0" CornerRadius="7" Background="{Binding CoverBackground}" ClipToBounds="True" MouseLeftButtonUp="CardClick" Tag="{Binding Model}" Cursor="Hand">
            <Grid><TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DDF1F5FF"/><Image Source="{Binding Cover}" Stretch="UniformToFill" Loaded="CoverLoaded"/></Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" MouseLeftButtonUp="CardClick" Tag="{Binding Model}" Cursor="Hand">
            <TextBlock Text="{Binding Model.Title}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Model.StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding Model.NextTask}" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding DetailVisibility}"/>
            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProgressCaption}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0"/></Grid>
            <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Margin="0,5,0,0" Visibility="{Binding ProgressVisibility}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Button Content="{Binding FinishIcon}" Tag="{Binding Model}" Click="FinishClick" Padding="0" Width="29" Height="29" FontSize="17" ToolTip="{DynamicResource Loc_da4837928478}" AutomationProperties.Name="{DynamicResource Loc_6cf94875ea7c}"/>
            <Button Content="⋯" Tag="{Binding Model}" Click="EditClick" Padding="0" Width="29" Height="26" FontSize="19" Margin="0,8,0,0" ToolTip="{DynamicResource Loc_20f9d62dd0f6}" AutomationProperties.Name="{DynamicResource Loc_ab5c261bc29a}"/>
            <Button Content="⠿" Tag="{Binding Model}" Padding="0" Width="29" Height="20" Margin="0,4,0,0" Cursor="SizeAll" PreviewMouseLeftButtonDown="DragHandleDown" PreviewKeyDown="DragHandleKey" ToolTip="{DynamicResource Loc_5a6575fe2e3d}" AutomationProperties.Name="{Binding ReorderName}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="GridCardTemplate">
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="9" Margin="0,0,9,0" Tag="{Binding Model}" AllowDrop="True" DragOver="CardDragOver" DragLeave="CardDragLeave" Drop="CardDrop">
        <StackPanel>
          <Border Height="190" CornerRadius="7" Background="{Binding CoverBackground}" ClipToBounds="True" MouseLeftButtonUp="CardClick" Tag="{Binding Model}" Cursor="Hand">
            <Grid><TextBlock Text="{Binding Initial}" FontSize="45" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DDF1F5FF"/><Image Source="{Binding Cover}" Stretch="UniformToFill" Loaded="CoverLoaded"/></Grid>
          </Border>
          <StackPanel MouseLeftButtonUp="CardClick" Tag="{Binding Model}" Cursor="Hand" Margin="0,10,0,0">
            <TextBlock Text="{Binding Model.Title}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model.Title}"/>
            <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Model.StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding Model.NextTask}" Foreground="{DynamicResource TextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding GridProgressCaption}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Margin="0,5,0,0"/>
          </StackPanel>
          <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="⠿" Tag="{Binding Model}" Padding="0" Width="28" Height="25" HorizontalAlignment="Left" Cursor="SizeAll" PreviewMouseLeftButtonDown="DragHandleDown" PreviewKeyDown="DragHandleKey" ToolTip="{DynamicResource Loc_5a6575fe2e3d}" AutomationProperties.Name="{Binding ReorderName}"/>
            <Button Grid.Column="1" Content="{Binding FinishIcon}" Tag="{Binding Model}" Click="FinishClick" Padding="0" Width="28" Height="25" FontSize="17" ToolTip="{DynamicResource Loc_da4837928478}" AutomationProperties.Name="{DynamicResource Loc_6cf94875ea7c}"/>
            <Button Grid.Column="2" Content="⋯" Tag="{Binding Model}" Click="EditClick" Padding="0" Width="28" Height="25" FontSize="19" Margin="5,0,0,0" ToolTip="{DynamicResource Loc_20f9d62dd0f6}" AutomationProperties.Name="{DynamicResource Loc_ab5c261bc29a}"/>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="GridRowTemplate">
      <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource GridCardTemplate}" Margin="0,0,-9,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="Shell" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Padding="22,17,22,16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,23">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragTitle" Cursor="SizeAll">
          <Border Width="29" Height="29" CornerRadius="8" Background="{DynamicResource AccentFillBrush}" Margin="0,0,9,0"><Path Data="M8,19 L8,7 L19,7 L16,11 L19,15 L10,15" Stroke="#FF102D27" StrokeThickness="2" StrokeLineJoin="Round"/></Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="checkpoint" FontWeight="Bold" FontSize="17"/><TextBlock Text="{DynamicResource Loc_3070e6c5ed66}" Foreground="{DynamicResource MutedBrush}" FontSize="8"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="PinButton" Content="◇" Click="PinClick" Width="29" Height="29" Padding="0" Margin="0,0,5,0" ToolTip="{DynamicResource Loc_ccd9c24d49b0}" AutomationProperties.Name="{DynamicResource Loc_ccd9c24d49b0}"/>
          <Button Content="⚙" Click="SettingsClick" Width="29" Height="29" Padding="0" Margin="0,0,5,0" ToolTip="{DynamicResource Loc_4f2debbbf4fa}" AutomationProperties.Name="{DynamicResource Loc_4f2debbbf4fa}"/>
          <Button Content="−" Click="HideClick" Width="29" Height="29" Padding="0" Margin="0,0,5,0" ToolTip="{DynamicResource Loc_f882ac34dce0}" AutomationProperties.Name="{DynamicResource Loc_1cea6be7bd3a}"/>
          <Button Content="×" Click="CloseClick" Width="29" Height="29" Padding="0" ToolTip="{DynamicResource Loc_aeccae342e4b}" AutomationProperties.Name="{DynamicResource Loc_aeccae342e4b}"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock x:Name="SummaryTitle" Text="{DynamicResource Loc_7a262f2c703d}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Summary" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
      <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="TrackedButton" Content="{DynamicResource Loc_041fb6146f6e}" Click="TrackedClick" Padding="10,7" Margin="0,0,5,0"/><Button x:Name="LibraryButton" Content="{DynamicResource Loc_c9169c12cba9}" Click="LibraryClick" Padding="10,7" Margin="0,0,5,0"/><Button x:Name="FriendsButton" Content="{DynamicResource Loc_bead8677698a}" Click="FriendsClick" Padding="10,7"/></StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource Loc_893f9701300c}" Style="{StaticResource AccentButton}" Click="AddClick" Padding="11,7" ToolTip="{DynamicResource Loc_234289d9e3d6}"/>
      </Grid>
      <Grid x:Name="FilterArea" Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,8,0"><TextBox x:Name="Search" TextChanged="FilterChanged" ToolTip="{DynamicResource Loc_13400b39ec9f}" AutomationProperties.Name="{DynamicResource Loc_d9b20ad96333}" Padding="10,7"/><TextBlock Text="{DynamicResource Loc_706954420e15}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectionChanged="FilterChanged" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Loc_74580843ea91}"><ComboBoxItem Content="{DynamicResource Loc_bd02b9a7d71d}"/><ComboBoxItem Content="{DynamicResource Loc_2ef68536d8e2}"/><ComboBoxItem Content="{DynamicResource Loc_185ac6464620}"/><ComboBoxItem Content="{DynamicResource Loc_d455cfb682d3}"/><ComboBoxItem Content="{DynamicResource Loc_4a76229cd4a2}"/><ComboBoxItem Content="{DynamicResource Loc_e82e91150650}"/></ComboBox>
      </Grid>
      <Grid x:Name="GameArea" Grid.Row="4">
        <ListBox x:Name="GameList" ItemTemplate="{StaticResource GameTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" SizeChanged="GameListSizeChanged"/>
        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="290" Margin="6">
          <Border Width="64" Height="64" Background="{DynamicResource PanelBrush}" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,18"><TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="EmptyTitle" Text="{DynamicResource Loc_d92a258c51ea}" TextAlignment="Center" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="EmptyText" Text="{DynamicResource Loc_c030ce966c27}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,18" LineHeight="19"/>
          <Button Content="{DynamicResource Loc_94665f4f307d}" Click="ConnectClick" Style="{StaticResource AccentButton}" Margin="15,0,15,8"/>
          <Button x:Name="ExampleButton" Content="{DynamicResource Loc_Example}" Click="ExampleClick" Margin="15,0,15,0"/>
        </StackPanel>
      </Grid>
      <Border x:Name="FriendsHost" Grid.Row="3" Grid.RowSpan="2" Visibility="Collapsed"/>
      <Grid Grid.Row="5" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ConnectionText" Text="{DynamicResource Loc_2f1941c17edd}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock x:Name="NoticeText" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,8,0" TextWrapping="Wrap" MaxWidth="290"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="UndoButton" Content="↶" Click="UndoClick" Width="30" Padding="0" Height="30" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="{DynamicResource Loc_UndoTooltip}" AutomationProperties.Name="{DynamicResource Loc_b55af60434ee}"/><Button x:Name="ViewButton" Content="▤" Click="ViewClick" Width="30" Padding="0" Height="30" Margin="0,0,6,0" ToolTip="{DynamicResource Loc_ViewTooltip}" AutomationProperties.Name="{DynamicResource Loc_6388939b12c2}"/><Button x:Name="SyncButton" Content="↻" Click="SyncClick" Width="30" Padding="0" Height="30" ToolTip="{DynamicResource Loc_Sync}" AutomationProperties.Name="{DynamicResource Loc_Sync}"/></StackPanel>
      </Grid>
      <Thumb x:Name="ResizeGrip" Grid.RowSpan="6" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-17,-12" Cursor="SizeNWSE" DragDelta="ResizeDrag"><Thumb.Template><ControlTemplate><Path Data="M4,12 L12,4 M9,13 L13,9" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"/></ControlTemplate></Thumb.Template></Thumb>
    </Grid>
  </Border>
</Window>
