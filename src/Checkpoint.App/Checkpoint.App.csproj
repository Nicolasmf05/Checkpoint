<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup><EmbeddedResource Include="LocalizationKeys.json" /></ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Checkpoint</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/checkpoint.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- This is a WPF entry point; only NotifyIcon uses Forms. DPI is managed by the WPF manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Checkpoint.Core/Checkpoint.Core.csproj" />
    <Content Include="service-config.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../supabase/project.json" Link="supabase-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
